# Aegira — local environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in the values:
#     cp .env.example .env
# `docker-compose.yml` reads these via ${VAR:-} substitution, so any value you
# leave blank simply becomes empty in the container — nothing is hardcoded, and
# this template contains NO real secrets. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Signs auth/session JWTs. Generate a strong random value:
#     openssl rand -hex 32
AUTH_JWT_SECRET=

# FRED (Federal Reserve Economic Data) — powers the macro dashboard.
# Free key: https://fredaccount.stlouisfed.org  (My Account -> API Keys)
FRED_API_KEY=

# Comma-separated emails granted staff / God-Eye (back-office) access.
# The email you REGISTER with must appear here to get staff access.
# e.g. JHI_STAFF_EMAILS=you@aegiraenterprise.com
JHI_STAFF_EMAILS=you@aegiraenterprise.com

# Public site URL used for canonical/OG links. For local use, keep as:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Recommended ------------------------------------------------------------

# Nasdaq Data Link — Sharadar SF1 fundamentals.
# Key: https://data.nasdaq.com  (Account Settings -> API Key)
NASDAQ_DATA_LINK_API_KEY=

# --- Optional ---------------------------------------------------------------

# BLS (Bureau of Labor Statistics) — optional; a free key raises rate limits.
# Register: https://www.bls.gov/developers/  (data.bls.gov/registrationEngine)
BLS_API_KEY=

# BEA (Bureau of Economic Analysis) — optional.
# Register: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# Anthropic API key — optional; editorial LLM (newsletter prose elevation).
# Get one: https://console.anthropic.com  (API Keys). Format: sk-ant-...
ANTHROPIC_API_KEY=

# Amazon Bedrock editorial (alternative to Anthropic-direct) — all optional.
# Provider auto-selects Bedrock when AWS_BEARER_TOKEN_BEDROCK is set.
# Leave ENABLE_LLM_EDITORIAL=0 to keep the editorial LLM OFF (default, no cost).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
ENABLE_LLM_EDITORIAL=0

# SBA 7(a) dataset URL — optional. When set, Main Street Acquirer pulls live SBA
# 7(a) FOIA data; if blank, it ships bundled sample data instead.
SBA_7A_DATASET_URL=

# Twelve Data (market data) — optional; leave blank.
# Key: https://twelvedata.com  (Dashboard -> API Keys)
TWELVEDATA_API_KEY=

# Stripe (billing) — optional; leave blank for local runs.
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=
